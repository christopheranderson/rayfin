{
  "name": "rayfin-vscode",
  "version": "0.16.0",
  "publisher": "fabric",
  "displayName": "Rayfin",
  "description": "VS Code extension for Rayfin development.",
  "engines": {
    "vscode": "^1.96.0"
  },
  "telemetry": true,
  "categories": [
    "Other"
  ],
  "main": "./dist/main.js",
  "browser": "./dist/web/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:rayfin/rayfin.yml",
    "onUri"
  ],
  "scripts": {
    "prebuild": "node scripts/bundle-template.mjs && node scripts/copy-plugin.mjs",
    "build": "tsc --noEmit && node scripts/bundle-template.mjs && node scripts/copy-plugin.mjs && node esbuild.mjs --production",
    "build:dev": "tsc --noEmit && node scripts/bundle-template.mjs && node scripts/copy-plugin.mjs && node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "clean": "rimraf dist rayfin templates",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "package": "rushx clean && rushx build && vsce package --allow-missing-repository --no-dependencies",
    "l10n": "node l10n/scripts/build.l10n.mjs",
    "l10n:check": "node l10n/scripts/check.l10n.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "~9.73.4",
    "@fluentui/react-icons": "~2.0.313",
    "@microsoft/rayfin-tools-common": "workspace:*",
    "@trpc/client": "~11.10.0",
    "@trpc/server": "~11.10.0",
    "@vscode/l10n": "~0.0.18",
    "yaml": "^2.8.2",
    "zod": "~3.24.0",
    "fflate": "~0.8.2",
    "@vscode/extension-telemetry": "^1.5.1",
    "@microsoft/applicationinsights-common": "^3.4.1"
  },
  "devDependencies": {
    "@testing-library/dom": "~10.4.1",
    "@testing-library/react": "~16.3.2",
    "@types/react": "~19.0.0",
    "@types/react-dom": "~19.0.0",
    "@types/vscode": "~1.96.0",
    "@vitest/coverage-v8": "~3.2.4",
    "@vscode/l10n-dev": "~0.0.35",
    "@vscode/vsce": "~3.7.0",
    "agent-browser": "~0.21.4",
    "esbuild": "0.28.1",
    "esbuild-sass-plugin": "~3.3.0",
    "glob": "~13.0.6",
    "jsdom": "~29.0.1",
    "react": "~19.0.0",
    "react-dom": "~19.0.0",
    "rimraf": "~6.0.1",
    "sass": "~1.87.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.3",
    "vscode-webview": "~1.0.1-beta.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "rayfin.signInWithMicrosoft",
        "title": "%rayfin.signInWithMicrosoft.title%",
        "category": "Project Rayfin"
      },
      {
        "command": "rayfin.up",
        "title": "%rayfin.up.title%",
        "category": "Project Rayfin"
      },
      {
        "command": "rayfin.upStaticDeploy",
        "title": "%rayfin.upStaticDeploy.title%",
        "category": "Project Rayfin"
      },
      {
        "command": "rayfin.openProjectView",
        "title": "%rayfin.openProjectView.title%",
        "category": "Project Rayfin"
      },
      {
        "command": "rayfin.createProject",
        "title": "%rayfin.createProject.title%",
        "category": "Project Rayfin"
      },
      {
        "command": "rayfin.openGettingStarted",
        "title": "%rayfin.openGettingStarted.title%",
        "category": "Project Rayfin"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rayfin.signInWithMicrosoft"
        },
        {
          "command": "rayfin.up"
        },
        {
          "command": "rayfin.upStaticDeploy"
        },
        {
          "command": "rayfin.openProjectView"
        },
        {
          "command": "rayfin.createProject"
        },
        {
          "command": "rayfin.openGettingStarted"
        }
      ],
      "explorer/context": [
        {
          "command": "rayfin.up",
          "group": "z_rayfin"
        }
      ]
    },
    "configuration": {
      "title": "Project Rayfin",
      "properties": {
        "rayfin.environment": {
          "type": "string",
          "default": "PROD",
          "description": "%rayfin.environment.description%"
        },
        "rayfin.environmentConfig": {
          "type": "object",
          "default": {},
          "description": "%rayfin.environmentConfig.description%",
          "properties": {
            "clientId": {
              "type": "string",
              "description": "%rayfin.environmentConfig.clientId.description%"
            },
            "scope": {
              "type": "string",
              "description": "%rayfin.environmentConfig.scope.description%"
            },
            "sessionProvider": {
              "type": "string",
              "enum": [
                "microsoft",
                "microsoft-sovereign-cloud"
              ],
              "description": "%rayfin.environmentConfig.sessionProvider.description%"
            }
          }
        }
      }
    },
    "languageModelTools": [
      {
        "name": "rayfin_up",
        "displayName": "%rayfin.tool.up.displayName%",
        "modelDescription": "Deploys the current Rayfin project to Microsoft Fabric. This pushes the application up, applies runtime settings, configures database schemas, and persists deployment metadata. Use when the user wants to deploy, push, or bring their Rayfin project up on Fabric.",
        "userDescription": "%rayfin.tool.up.userDescription%",
        "toolReferenceName": "up",
        "canBeReferencedInPrompt": true,
        "icon": "$(cloud-upload)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspaceName": {
              "type": "string",
              "description": "The display name of the Fabric workspace to deploy into. Defaults to 'My workspace' if not specified."
            }
          }
        },
        "tags": [
          "rayfin",
          "fabric",
          "deploy",
          "up"
        ]
      }
    ]
  },
  "license": "MIT"
}
