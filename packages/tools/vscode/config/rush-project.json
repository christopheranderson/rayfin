/**
 * Rush-specific settings for the Rayfin VS Code extension.
 *
 * The build produces three things: `dist/`, the esbuild bundle; `templates/`,
 * the samples vendored by `scripts/bundle-template.mjs`; and `rayfin/`, the copy
 * of the repo-root `plugin/` made by `scripts/copy-plugin.mjs`. All three are
 * packaged into the vsix (see `!templates/**` and `!rayfin/**` in
 * `.vscodeignore`), and all three are gitignored.
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush-project.schema.json",

  /**
   * Both generators read outside this project folder, `samples/` and the
   * repo-root `plugin/`, so their inputs are invisible to Rush's incremental
   * analyzer. A cache key computed from this folder alone can be fresh while the
   * vendored template or plugin is stale, which declaring the output folders
   * does not fix.
   */
  "disableBuildCacheForProject": true,

  "operationSettings": [
    {
      "operationName": "build",
      "outputFolderNames": ["dist", "templates", "rayfin"]
    }
  ]
}
