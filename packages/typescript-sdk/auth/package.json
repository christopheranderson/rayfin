{
  "name": "@microsoft/rayfin-auth",
  "version": "1.36.2",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./_internal": {
      "import": "./dist/_internal.js",
      "types": "./dist/_internal.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "LICENSE",
    "assets/docs"
  ],
  "devDependencies": {
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "@vitest/coverage-v8": "~3.2.4",
    "rimraf": "~6.0.1"
  },
  "dependencies": {
    "@microsoft/rayfin-lib": "workspace:*"
  },
  "scripts": {
    "build": "tsc && node ../scripts/fix-esm-extensions.mjs ./dist",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist && rimraf .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/rayfin.git",
    "directory": "packages/typescript-sdk/auth"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "rayfinDocs": {
    "version": 1,
    "dir": "assets/docs",
    "module": "rayfin-auth",
    "kind": "api-reference"
  }
}
