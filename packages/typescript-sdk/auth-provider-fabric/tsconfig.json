{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      "@microsoft/rayfin-auth": ["../auth/src"],
      "@microsoft/rayfin-auth/*": ["../auth/src/*"],
      "@microsoft/fabric-embedded-host": ["../fabric-embedded-host/src"],
      "@microsoft/fabric-embedded-host/*": ["../fabric-embedded-host/src/*"],
      "@microsoft/rayfin-lib": ["../lib/src"],
      "@microsoft/rayfin-lib/*": ["../lib/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],
  "references": [
    { "path": "../auth" },
    { "path": "../fabric-embedded-host" },
    { "path": "../lib" }
  ]
}
