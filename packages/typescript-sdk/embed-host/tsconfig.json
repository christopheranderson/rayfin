{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      "@microsoft/rayfin-lib": ["../lib/src"],
      "@microsoft/rayfin-lib/*": ["../lib/src/*"],
      "@microsoft/fabric-embedded-host": ["../fabric-embedded-host/src"],
      "@microsoft/fabric-embedded-host/*": ["../fabric-embedded-host/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../lib" }, { "path": "../fabric-embedded-host" }]
}
