{
  "name": "@microsoft/rayfin-lib",
  "version": "1.36.1",
  "description": "Shared library utilities and HTTP client foundation for the Rayfin platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "LICENSE",
    "assets/docs"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/rayfin.git",
    "directory": "packages/typescript-sdk/lib"
  },
  "dependencies": {
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pluralize": "^0.0.33",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "@vitest/coverage-v8": "~3.2.4",
    "rimraf": "~6.0.1"
  },
  "scripts": {
    "build": "tsc && node ../scripts/fix-esm-extensions.mjs ./dist",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist && rimraf .tsbuildinfo",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "rayfinDocs": {
    "version": 1,
    "dir": "assets/docs",
    "module": "rayfin-lib",
    "kind": "api-reference"
  }
}
