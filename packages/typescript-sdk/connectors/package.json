{
  "name": "@microsoft/rayfin-connectors",
  "version": "1.36.2",
  "description": "Typed runtime for invoking Rayfin function-bridge connectors (e.g. fabric-semanticmodel).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "assets/docs",
    "LICENSE"
  ],
  "rayfinDocs": {
    "version": 1,
    "dir": "assets/docs",
    "module": "rayfin-connectors",
    "kind": "api-reference"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "@vitest/coverage-v8": "~3.2.4",
    "rimraf": "~6.0.1"
  },
  "dependencies": {
    "@microsoft/rayfin-core": "workspace:*",
    "@microsoft/rayfin-data": "workspace:*",
    "@microsoft/rayfin-lib": "workspace:*",
    "@microsoft/rayfin-tools-common": "workspace:*"
  },
  "scripts": {
    "build": "tsc && node ../scripts/fix-esm-extensions.mjs ./dist",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist && rimraf .tsbuildinfo",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/project-rayfin.git",
    "directory": "packages/typescript-sdk/connectors"
  },
  "keywords": [],
  "author": "Microsoft",
  "license": "MIT",
  "type": "module"
}
