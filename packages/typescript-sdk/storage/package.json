{
  "name": "@microsoft/rayfin-storage",
  "version": "1.36.1",
  "description": "Type-safe client library for Rayfin storage operations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "assets/docs",
    "LICENSE"
  ],
  "dependencies": {
    "@microsoft/rayfin-lib": "workspace:*",
    "@microsoft/rayfin-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "rimraf": "~6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "@vitest/coverage-v8": "~3.2.4"
  },
  "scripts": {
    "build": "tsc && node ../scripts/fix-esm-extensions.mjs ./dist",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist && rimraf .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:integration:watch": "vitest src/__tests__/integration/"
  },
  "keywords": [
    "rayfin",
    "storage",
    "typescript",
    "client",
    "blob"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/rayfin.git",
    "directory": "packages/typescript-sdk/storage"
  },
  "rayfinDocs": {
    "version": 1,
    "dir": "assets/docs",
    "module": "rayfin-storage",
    "kind": "api-reference"
  }
}
