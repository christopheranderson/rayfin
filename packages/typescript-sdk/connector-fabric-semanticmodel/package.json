{
  "name": "@microsoft/rayfin-connector-fabric-semanticmodel",
  "version": "1.36.2",
  "description": "Typed connector marker for the Fabric semantic-model (Power BI dataset) connector category. Pair with @microsoft/rayfin-client to type `client.connectors.<name>.executeQuery(...)`.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "assets/docs",
    "LICENSE"
  ],
  "rayfinDocs": {
    "version": 1,
    "dir": "assets/docs",
    "module": "rayfin-connector-fabric-semanticmodel",
    "kind": "api-reference"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "@vitest/coverage-v8": "~3.2.4",
    "rimraf": "~6.0.1"
  },
  "dependencies": {
    "@microsoft/rayfin-connectors": "workspace:*",
    "apache-arrow": "^21.1.0",
    "lz4js": "^0.2.0"
  },
  "scripts": {
    "build": "tsc && node ../scripts/fix-esm-extensions.mjs ./dist",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist && rimraf .tsbuildinfo",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/project-rayfin.git",
    "directory": "packages/typescript-sdk/connector-fabric-semanticmodel"
  },
  "keywords": [
    "rayfin",
    "fabric",
    "semantic-model",
    "powerbi",
    "dax"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "type": "module"
}
