{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": ".tsbuildinfo",
    // Allow unused parameters for proxy handlers
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "paths": {
      "@microsoft/rayfin-lib": ["../lib/src"],
      "@microsoft/rayfin-lib/*": ["../lib/src/*"],
      "@microsoft/rayfin-core": ["../core/src"],
      "@microsoft/rayfin-core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/__tests__/type-safety/test-cases/*"
  ],
  "references": [{ "path": "../core" }, { "path": "../lib" }]
}
