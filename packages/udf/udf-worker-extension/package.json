{
  "name": "@microsoft/fabric-user-data-functions",
  "version": "1.36.1",
  "description": "TypeScript extension for Microsoft Fabric User Data Functions",
  "license": "MIT",
  "author": "Microsoft",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "README.md",
    "LICENSE",
    "assets/docs"
  ],
  "rayfinDocs": {
    "version": 1,
    "dir": "assets/docs",
    "module": "fabric-user-data-functions",
    "kind": "api-reference"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist .tsbuildinfo",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint:tests": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm run test && npm run lint"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0 || >=22.0.0 <23.0.0 || >=24.0.0 <25.0.0"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@microsoft/rayfin-client": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.10",
    "jest": "^29.7.0",
    "rimraf": "~6.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "js-yaml": ">=3.15.1 <4",
    "brace-expansion@1": "1.1.18",
    "@babel/core": ">=7.29.6 <8",
    "baseline-browser-mapping": "2.11.12",
    "browserslist": "4.28.7",
    "caniuse-lite": "1.0.30001806",
    "electron-to-chromium": "1.5.401",
    "node-releases": "2.0.52",
    "update-browserslist-db": "1.2.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/project-rayfin.git",
    "directory": "packages/udf-worker-extension"
  },
  "keywords": [
    "fabric",
    "user-data-functions",
    "typescript",
    "azure-functions"
  ]
}
