{
  "name": "todo-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin dev",
    "dev:frontend": "vite",
    "dev:mock": "node scripts/toggle-service-mode.js mock && vite",
    "dev:rayfin": "node scripts/run-rayfin-db.js && node scripts/toggle-service-mode.js rayfin && vite",
    "toggle-mode": "node scripts/toggle-service-mode.js",
    "rayfin:db": "cross-env RAYFIN_FEATURE_FLAGS=docker-local-dev rayfin dev db apply",
    "rayfin:storage": "cross-env RAYFIN_FEATURE_FLAGS=docker-local-dev rayfin dev storage apply",
    "rayfin:dev": "cross-env RAYFIN_FEATURE_FLAGS=docker-local-dev rayfin dev --provider docker",
    "rayfin:dev:purge": "cross-env RAYFIN_FEATURE_FLAGS=docker-local-dev rayfin --yes dev --down --purge",
    "rayfin:dev:local": "cross-env RAYFIN_FEATURE_FLAGS=docker-local-dev COMPOSE_FILE=docker-compose.override.yml COMPOSE_PROJECT_DIRECTORY=../.. rayfin dev --provider docker",
    "rayfin:dev:local:rebuild": "docker compose -f rayfin/.temp/docker-compose.yml -f docker-compose.override.yml --project-directory ../.. --env-file rayfin/.env build webservice && npm run rayfin:dev:local",
    "clean": "rimraf tsconfig.tsbuildinfo && rimraf rayfin/.temp/compiled",
    "build": "tsc --build && vite build",
    "build:fabric": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:ui && npm run test:e2e:api",
    "test:e2e:debug": "npm run test:e2e:ui:debug && npm run test:e2e:api:debug",
    "test:e2e:api": "npm-run-all --continue-on-error -s test:e2e:api:core test:e2e:api:email",
    "test:e2e:api:core": "cross-env E2E_KEEP_BACKEND_RUNNING=true AUTH_EMAIL_ENABLED=false vitest run --config e2e/api/vitest.config.ts",
    "test:e2e:api:email": "cross-env AUTH_EMAIL_ENABLED=true vitest run --config e2e/api/vitest.email.config.ts",
    "test:e2e:api:rt": "cross-env E2E_KEEP_BACKEND_RUNNING=true vitest run --config e2e/api/vitest.rt.config.ts",
    "test:e2e:api:rt:absolute": "cross-env AUTH_RT_ABSOLUTE_LIFETIME_MINUTES=1 vitest run --config e2e/api/vitest.rt.config.ts",
    "test:e2e:api:watch": "vitest watch --config e2e/api/vitest.config.ts",
    "test:e2e:api:ui": "vitest --ui --config e2e/api/vitest.config.ts",
    "test:e2e:api:debug": "cross-env E2E_KEEP_BACKEND_RUNNING=true npm run test:e2e:api",
    "test:e2e:ui": "playwright test --config e2e/ui/playwright.config.ts",
    "test:e2e:ui:headed": "playwright test --config e2e/ui/playwright.config.ts --headed",
    "test:e2e:ui:debug": "cross-env E2E_KEEP_BACKEND_RUNNING=true playwright test --config e2e/ui/playwright.config.ts --debug"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "workspace:*",
    "@microsoft/rayfin-client": "workspace:*",
    "@microsoft/rayfin-core": "workspace:*",
    "@microsoft/rayfin-data": "workspace:*",
    "@microsoft/rayfin-storage": "workspace:*",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@microsoft/rayfin-cli": "workspace:*",
    "@microsoft/rayfin-mcp": "workspace:*",
    "@types/node": "^20.4.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "3.2.6",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^9.29.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "~3.2.4",
    "@testing-library/dom": "^10.0.0",
    "rimraf": "~6.0.1",
    "@types/react": "~19.2.7",
    "@types/react-dom": "^19.2.2",
    "@playwright/test": "~1.57.0",
    "npm-run-all": "~4.1.5",
    "pluralize": "~8.0.0",
    "@types/pluralize": "~0.0.33"
  }
}
