import {
  entity,
  role,
  uuid,
  text,
  int,
  boolean,
  date,
} from '@microsoft/rayfin-core';

@entity()
@role('authenticated', '*', {
  policy: (claims, item) => claims.sub.eq(item.user_id),
})
export class UniqueEntity {
  @uuid() id!: string;
  @text() name!: string;
  @text({ unique: true }) slug!: string;
  @int() value!: number;
  @boolean() active!: boolean;
  @date() createdAt!: Date;

  @text() user_id!: string;
}
