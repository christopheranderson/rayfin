{
  "name": "eshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin dev",
    "dev:frontend": "vite",
    "dev:fabric": "vite",
    "dev:mock": "cross-env VITE_SERVICE_MODE=mock vite",
    "dev:rayfin": "npm run rayfin:db && cross-env VITE_SERVICE_MODE=rayfin vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "clean": "rimraf tsconfig.tsbuildinfo && rimraf rayfin/.temp/compiled",
    "toggle-mode": "node scripts/toggle-service-mode.js",
    "rayfin:db": "rayfin db gen-config && rayfin db apply"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@microsoft/rayfin-client": "workspace:*",
    "@microsoft/rayfin-core": "workspace:*",
    "@microsoft/rayfin-data": "workspace:*",
    "@microsoft/rayfin-auth": "workspace:*",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-router": "^1.131.3",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/router-devtools": "^1.58.3",
    "@tanstack/router-vite-plugin": "^1.58.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.53.0",
    "react-icons": "^5.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@microsoft/rayfin-cli": "workspace:*",
    "@playwright/test": "^1.47.0",
    "@tanstack/react-query-devtools": "^5.85.3",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "3.2.6",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^9.29.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4",
    "baseline-browser-mapping": "~2.8.32"
  }
}
